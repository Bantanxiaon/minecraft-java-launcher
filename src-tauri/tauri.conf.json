{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SH启动器",
  "version": "0.4.9",
  "identifier": "com.shlauncher.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SH启动器",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gh-proxy.com/https://github.com/Bantanxiaon/minecraft-java-launcher/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/Bantanxiaon/minecraft-java-launcher/releases/latest/download/latest.json",
        "https://github.com/Bantanxiaon/minecraft-java-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwOTFFMzIyRDI3MDQzM0EKUldRNlEzRFNJdU9Sa09WdW9NbUlLY1BKckNyeC9FTE4xc3F5Nll6L1k1S3R3ejlsSEdMcXV4V1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
