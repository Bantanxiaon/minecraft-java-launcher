<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SHLauncher.UI.ViewModels" xmlns:i="using:SHLauncher.Contracts.Install" xmlns:c="using:SHLauncher.UI.Components" x:Class="SHLauncher.UI.Views.Pages.DownloadsView" x:DataType="vm:DownloadsViewModel">
 <UserControl.Styles><StyleInclude Source="/Design/Controls.axaml"/></UserControl.Styles>
 <ThemeVariantScope Name="LegacyTheme" RequestedThemeVariant="Dark">
  <Grid Margin="32,20,32,16" RowDefinitions="Auto,Auto,*" RowSpacing="16">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="下载" FontSize="28"/><Button Grid.Column="1" Content="导入整合包" Command="{Binding ImportCommand}"/></Grid>
   <StackPanel Grid.Row="1" Spacing="12">
    <TextBlock Text="Minecraft" FontSize="16" FontWeight="SemiBold"/>
    <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10"><TextBox Name="SearchInput" Text="{Binding Search}" PlaceholderText="搜索版本" AutomationProperties.Name="搜索 Minecraft 版本"/><ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedIndex="{Binding Filter}"/><Button Grid.Column="2" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}"/></Grid>
    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
   <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="24">
    <Grid RowDefinitions="*,Auto" RowSpacing="12"><ListBox Name="VersionList" ItemsSource="{Binding VisibleVersions}" SelectedItem="{Binding Minecraft}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="i:MinecraftVersionInfo"><Grid ColumnDefinitions="*,Auto" Margin="8,10"><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Opacity="0.6" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="1" Content="安装所选版本" Click="OpenInstall" HorizontalAlignment="Right"/></Grid>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12"><TextBlock Text="{Binding TaskSummary}" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1"><StackPanel Spacing="8"><TextBlock Text="暂无下载任务" IsVisible="{Binding IsEmpty}" Opacity="0.6"/><ItemsControl ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DownloadCardViewModel"><c:DownloadTaskCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
   </Grid>
  </Grid>
 </ThemeVariantScope>
</UserControl>
