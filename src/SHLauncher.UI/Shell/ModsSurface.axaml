<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SHLauncher.UI.ViewModels" x:Class="SHLauncher.UI.Shell.ModsSurface" x:DataType="vm:ModsViewModel">
 <UserControl.Styles><Style Selector="ListBox#ModList ListBoxItem"><Setter Property="Padding" Value="8,3"/><Setter Property="MinHeight" Value="0"/></Style></UserControl.Styles>
 <Grid Margin="32,20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" FontSize="28"/><TextBlock Text="{Binding Counts}" Opacity="0.6"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Mods 文件夹" Command="{Binding OpenFolderCommand}"/><Button Content="在线安装 / 更新" Click="Online" IsEnabled="{Binding CanEdit}"/><Button Content="添加本地 Mod" Click="AddLocal" IsEnabled="{Binding CanEdit}"/></StackPanel></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding Search}" PlaceholderText="搜索名称、ID 或文件名"/><ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedIndex="{Binding Filter}"/><Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}"/><Button Grid.Column="3" Content="强制刷新" Command="{Binding ForceRefreshCommand}"/></Grid>
  <TextBlock Grid.Row="2" IsVisible="{Binding HasMessage}" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/>
  <ListBox Grid.Row="3" Name="ModList" ItemsSource="{Binding Rows}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ModRow"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Margin="4,3"><CheckBox IsChecked="{Binding Selected}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="15"/><TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/><TextBlock IsVisible="{Binding HasProblem}" Text="{Binding Problem}" FontSize="12" Foreground="#F5B77F"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="详情" Click="Details"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12"><Button Content="全选 / 取消" Command="{Binding SelectAllCommand}"/><StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasSelection}"><TextBlock Text="{Binding SelectedCount, StringFormat='已选择 {0} 个'}" VerticalAlignment="Center"/><Button Content="启用" Command="{Binding EnableCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="禁用" Command="{Binding DisableCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="删除" Click="Recycle" IsEnabled="{Binding CanEdit}"/></StackPanel></StackPanel>
 </Grid>
</UserControl>
