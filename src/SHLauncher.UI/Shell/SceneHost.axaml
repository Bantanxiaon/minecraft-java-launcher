<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SHLauncher.UI.Shell.SceneHost" IsHitTestVisible="False">
 <Grid ClipToBounds="True">
  <Grid Name="DynamicBackgroundHost">
   <Image Name="StaticFallback" Stretch="UniformToFill"/>
   <Image Name="DynamicImage" Stretch="UniformToFill"/>
  </Grid>
  <Border Background="#10274870"/>
  <Border><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
   <GradientStop Color="#1A080E18" Offset="0"/><GradientStop Color="#00080E18" Offset="0.45"/><GradientStop Color="#B8080E18" Offset="1"/>
  </LinearGradientBrush></Border.Background></Border>
  <Grid Name="MaterialLayer">
   <Border Name="MaterialSurface">
    <Border.OpacityMask><LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
     <GradientStop Color="#00FFFFFF" Offset="0.49"/><GradientStop Color="White" Offset="0.56"/>
    </LinearGradientBrush></Border.OpacityMask>
   </Border>
  </Grid>
 </Grid>
</UserControl>
