      <SolidColorBrush x:Key="Action.Disabled" Color="#E1E4DE"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Background.Primary" Color="#15181F"/>
      <SolidColorBrush x:Key="Background.Secondary" Color="#1A1E27"/>
      <SolidColorBrush x:Key="Surface.Primary" Color="#202530"/>
      <SolidColorBrush x:Key="Surface.Secondary" Color="#1C212B"/>
      <SolidColorBrush x:Key="Surface.Elevated" Color="#293140"/>
      <SolidColorBrush x:Key="Surface.Glass" Color="#DA293140"/>
      <SolidColorBrush x:Key="Surface.Selected" Color="#283B53"/>
      <SolidColorBrush x:Key="Surface.Hover" Color="#293140"/>
      <SolidColorBrush x:Key="Navigation.Selected" Color="#2A405E"/>
      <SolidColorBrush x:Key="Border.Subtle" Color="#343E4E"/>
      <SolidColorBrush x:Key="Text.Primary" Color="#EEF2FA"/>
      <SolidColorBrush x:Key="Text.Secondary" Color="#ADB8CA"/>
      <SolidColorBrush x:Key="Text.Tertiary" Color="#9BA8BD"/>
      <SolidColorBrush x:Key="Accent.Primary" Color="#438DEB"/>
      <SolidColorBrush x:Key="State.Success" Color="#B1CCA7"/>
      <SolidColorBrush x:Key="State.Error" Color="#F3B9AB"/>
      <SolidColorBrush x:Key="State.ErrorSurface" Color="#482F2C"/>
      <SolidColorBrush x:Key="State.Warning" Color="#D8C18E"/>
      <SolidColorBrush x:Key="State.Disabled" Color="#7E8A80"/>
      <SolidColorBrush x:Key="Action.Foreground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Action.Disabled" Color="#313C4C"/>
    </ResourceDictionary>
