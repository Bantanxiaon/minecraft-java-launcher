      <SolidColorBrush x:Key="Text.Primary" Color="#262F2D"/>
      <SolidColorBrush x:Key="Text.Secondary" Color="#626D67"/>
      <SolidColorBrush x:Key="Text.Tertiary" Color="#626D67"/>
      <SolidColorBrush x:Key="Accent.Primary" Color="#2771CF"/>
      <SolidColorBrush x:Key="State.Success" Color="#3F674F"/>
      <SolidColorBrush x:Key="State.Error" Color="#A63D3B"/>
