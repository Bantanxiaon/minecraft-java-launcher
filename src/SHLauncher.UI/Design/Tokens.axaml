<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="using:System">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Background.Primary" Color="#F5F4F0"/>
      <SolidColorBrush x:Key="Background.Secondary" Color="#EEEDE8"/>
      <SolidColorBrush x:Key="Surface.Primary" Color="#FDFCFA"/>
